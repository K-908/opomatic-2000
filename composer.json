{
  "name": "opomatic/opomatic-2000",
  "description": "API PHP de OpoMatic-2000",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "autoload": {
    "psr-4": {
      "OpoMatic2000\\": "backend/src/"
    }
  },
  "scripts": {
